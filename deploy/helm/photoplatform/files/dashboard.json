{
  "uid": "photoplatform-kubernetes",
  "title": "Photoplatform Kubernetes runtime",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "API request rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{component=\"api\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{pod}} {{deployment}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "API p95 latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95,sum by(le)(rate(http_server_requests_seconds_bucket{component=\"api\"}[5m])))",
          "refId": "A",
          "legendFormat": "{{pod}} {{deployment}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Durable outbox rows",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "max(media_outbox_pending)",
          "refId": "A",
          "legendFormat": "{{pod}} {{deployment}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Oldest unpublished outbox age",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "max(media_outbox_oldest_age_seconds)",
          "refId": "A",
          "legendFormat": "{{pod}} {{deployment}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "MQ work per deployment",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "photoplatform_queue_depth",
          "refId": "A",
          "legendFormat": "{{pod}} {{deployment}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Ready worker Pods",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "photoplatform_worker_ready_pods",
          "refId": "A",
          "legendFormat": "{{pod}} {{deployment}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Queue sample availability",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "photoplatform_queue_collector_available",
          "refId": "A",
          "legendFormat": "{{pod}} {{deployment}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "DB pool pending per Pod",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "hikaricp_connections_pending",
          "refId": "A",
          "legendFormat": "{{pod}} {{deployment}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "Pod restarts",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "kube_pod_container_status_restarts_total",
          "refId": "A",
          "legendFormat": "{{pod}} {{deployment}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "Due durable job age",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "max(media_oldest_queued_job_age_seconds)",
          "refId": "A",
          "legendFormat": "{{pod}} {{deployment}}"
        }
      ]
    },
    {
      "id": 11,
      "title": "Encoder warmed model",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "encoder_model_ready",
          "refId": "A",
          "legendFormat": "{{pod}} {{deployment}}"
        }
      ]
    },
    {
      "id": 12,
      "title": "Encoder version mismatch requests",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "increase(encoder_model_version_mismatches_total[10m])",
          "refId": "A",
          "legendFormat": "{{pod}} {{deployment}}"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "tags": [
    "photoplatform",
    "kubernetes"
  ]
}
